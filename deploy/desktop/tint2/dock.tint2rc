# 画面下のドック: アプリのランチャー

# 背景 1: ドック
rounded = 16
border_width = 1
background_color = #161a33 80
border_color = #c9b26b 45

# 背景 2: マウスを重ねたアイコン
rounded = 10
border_width = 0
background_color = #ffffff 18
border_color = #000000 0

panel_items = L
panel_size = 100% 64
panel_shrink = 1
panel_margin = 0 8
panel_padding = 12 8 12
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_window_name = luna-dock
strut_policy = follow_size
panel_dock = 0
mouse_effects = 1
mouse_hover_icon_asb = 100 0 15
mouse_pressed_icon_asb = 100 0 -10

launcher_padding = 2 2 12
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 44
launcher_icon_theme = Papirus
launcher_icon_theme_override = 1
launcher_tooltip = 1
startup_notifications = 1
launcher_item_app = /opt/luna-desktop/share/applications/luna-chrome.desktop
launcher_item_app = /usr/share/applications/xfce4-terminal.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/org.xfce.mousepad.desktop
launcher_item_app = /usr/share/applications/org.xfce.ristretto.desktop
