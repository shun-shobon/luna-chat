[Unit]
Description=Luna desktop window manager
PartOf=luna-desktop.target
Requires=luna-desktop-xvfb.service luna-desktop-dbus.service
After=luna-desktop-xvfb.service luna-desktop-dbus.service

[Service]
User=luna
Group=luna
EnvironmentFile=/opt/luna-desktop/etc/session.env
ExecStart=/usr/bin/openbox --config-file /opt/luna-desktop/etc/openbox-rc.xml
Restart=always
RestartSec=2
