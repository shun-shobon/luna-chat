[Unit]
Description=Luna desktop screen sharing (neko)
PartOf=luna-desktop.target
Requires=luna-desktop-xvfb.service luna-desktop-pulseaudio.service
After=luna-desktop-xvfb.service luna-desktop-pulseaudio.service

[Service]
User=luna
Group=luna
EnvironmentFile=/opt/luna-desktop/etc/session.env
EnvironmentFile=/etc/luna-desktop/neko.env
ExecStart=/opt/luna-desktop/neko/bin/neko serve --legacy=false --config /opt/luna-desktop/etc/neko.yaml
KillSignal=SIGINT
Restart=always
RestartSec=2
