  <discord_context kind="channel" channel_id="channel-id" channel_name="channel-name" />
  <recent_messages count="2">
    <message id="recent-message-id-1" channel_id="channel-id" author_id="recent-author-id-1" author_name="recent-author-name-1" author_is_bot="false" created_at="2026-02-23 08:56:00 JST" mentioned_bot="false">
      <reply_to>
