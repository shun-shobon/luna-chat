{
  "name": "luna-chat",
  "version": "0.1.0",
  "private": true,
  "description": "luna-chat",
  "license": "MIT",
  "author": "NISHIZAWA Shuntaro <me@s2n.tech>",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx --watch src/index.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen": "pnpm run /^gen:.*$/",
    "gen:app-server": "codex app-server generate-ts --out src/generated/codex",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "./dist/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/mcp": "0.2.4",
    "@hono/node-server": "1.19.11",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@openai/codex": "0.111.0",
    "chokidar": "5.0.0",
    "confbox": "0.2.4",
    "consola": "3.4.2",
    "cron": "4.4.0",
    "discord.js": "14.25.1",
    "hono": "4.12.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "25.3.3",
    "knip": "5.85.0",
    "oxfmt": "0.36.0",
    "oxlint": "1.51.0",
    "oxlint-tsgolint": "0.16.0",
    "tsdown": "0.20.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@10.30.3"
}
