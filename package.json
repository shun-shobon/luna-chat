{
  "name": "luna-chat",
  "version": "0.1.0",
  "private": true,
  "description": "luna-chat",
  "license": "MIT",
  "author": "NISHIZAWA Shuntaro <me@s2n.tech>",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx --watch src/index.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen": "pnpm run /^gen:.*$/",
    "gen:app-server": "codex app-server generate-ts --out src/generated/codex",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/mcp": "0.3.1",
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.153.4",
    "chokidar": "5.0.0",
    "cron": "4.4.0",
    "discord.js": "14.27.0",
    "hono": "4.12.33",
    "smol-toml": "1.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "knip": "6.31.0",
    "nf3": "0.3.23",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.18.0"
}
