{
  "name": "luna-chat",
  "version": "0.1.0",
  "private": true,
  "description": "luna-chat",
  "license": "MIT",
  "author": "NISHIZAWA Shuntaro <me@s2n.tech>",
  "type": "module",
  "scripts": {
    "build": "tsdown && node scripts/build-sea.mjs",
    "dev": "tsx --watch src/index.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen": "pnpm run /^gen:.*$/",
    "gen:app-server": "codex app-server generate-ts --out src/generated/codex",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "./dist/luna-chat",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/mcp": "0.3.2",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "chokidar": "5.0.0",
    "cron": "4.4.0",
    "discord.js": "14.27.0",
    "hono": "4.13.7",
    "smol-toml": "1.8.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@openai/codex": "0.154.0",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.4",
    "knip": "6.35.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "postject": "1.0.0-alpha.6",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.4.0"
}
