{
	"name": "luna-chat",
	"version": "0.6.0",
	"private": true,
	"description": "luna-chat",
	"license": "MIT",
	"author": "NISHIZAWA Shuntaro <me@s2n.tech>",
	"bin": {
		"luna-chat": "./dist/index.mjs"
	},
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"dev": "tsx --watch src/index.ts",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"knip": "knip",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"start": "node dist/index.mjs",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@hono/node-server": "2.1.1",
		"chokidar": "5.0.0",
		"citty": "0.2.2",
		"cron": "4.4.0",
		"discord.js": "14.27.0",
		"hono": "4.13.9",
		"pino": "10.4.0",
		"smol-toml": "1.9.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@shun-shobon/oxfmt-config": "7.0.0",
		"@shun-shobon/oxlint-config": "7.0.0",
		"@tsconfig/node-lts": "24.0.1",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "24.19.0",
		"knip": "6.38.0",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"tsdown": "0.23.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.2"
	},
	"packageManager": "pnpm@12.7.0"
}
